#!/bin/sh
# pre-push-journal-test — the hook's own failure-path suite.
#
# The hook is the only guard on a branch that has no reviewer, so the assertion that matters is not
# "it lets a clean push through" — it is that it REFUSES on every path where it did not sweep. That
# is the direction a control fails silently in, and the direction a hand-run smoke test never
# exercises, because the happy path is the one you are trying when you write it.
#
# The gate itself is stubbed here on purpose. Whether `privacy-check` MATCHES correctly is that
# tool's question and it has 27 fixtures of its own; this suite asks only whether the hook does the
# right thing with each answer it can get back. Stubbing is what makes exit 2 testable at all.
#
# Needs no private layer and no network. Exit 0 all pass · 1 a failure.

set -eu

hook=$(cd "$(dirname "$0")" && pwd)/pre-push-journal
[ -x "$hook" ] || {
	echo "pre-push-journal-test: $hook is not executable" >&2
	exit 1
}

work=${TMPDIR:-/tmp}/pre-push-journal-test.$$
trap 'rm -rf "$work"' EXIT
mkdir -p "$work"

# THE SUITE BUILDS THE ENVIRONMENT IT ASSERTS ABOUT, and the first version did not.
#
# It ran the hook in whatever directory it was invoked from, which made two of its nine cases
# depend on that directory:
#
#   - "no gate configured" PASSED only where `quince.privacy-check` happened to be unset. In a
#     correctly provisioned clone — the box where this hook actually runs — the config fallback
#     supplies a real gate and the case fails. Green in the empty case, red where it is deployed,
#     which is the worst polarity a test can have.
#   - "gate clean -> allow" PASSED only INSIDE a git repository, because the hook reads
#     `--show-toplevel`. Outside one it exited 128 on a git fatal.
#
# So: a throwaway repository per run, and the global and system config files pointed at /dev/null,
# so `git config --get` sees exactly what this file puts there and nothing the box happens to hold.
repo=$work/repo
mkdir -p "$repo"
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_SYSTEM=/dev/null
export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
git -C "$repo" init -q 2>/dev/null || {
	echo "pre-push-journal-test: cannot git init in $repo — DID NOT RUN" >&2
	exit 1
}
# Prove the neutralisation rather than trusting it: if this ever returns a value, the two cases
# above are silently testing the box instead of the hook.
if git -C "$repo" config --get quince.privacy-check >/dev/null 2>&1; then
	echo "pre-push-journal-test: quince.privacy-check leaked into the throwaway repo — DID NOT RUN" >&2
	exit 1
fi

pass=0
fail=0

stub() { # stub <exit-code>
	cat >"$work/gate" <<EOF
#!/bin/sh
echo "stub gate: called with \$*"
exit $1
EOF
	chmod +x "$work/gate"
	printf '%s' "$work/gate"
}

# check <name> <want-exit> <want-substring> <remote-sha> <gate-or-empty>
check() {
	name=$1
	want=$2
	needle=$3
	rsha=$4
	gate=$5
	out=$(printf 'refs/heads/journal 1111111111111111111111111111111111111111 refs/heads/journal %s\n' "$rsha" |
		(cd "$repo" && env QUINCE_PRIVACY_CHECK="$gate" "$hook") 2>&1) && rc=0 || rc=$?
	if [ "$rc" != "$want" ]; then
		printf 'FAIL %-42s exit %s, wanted %s\n' "$name" "$rc" "$want" >&2
		printf '     output: %s\n' "$out" >&2
		fail=$((fail + 1))
		return
	fi
	case $out in
	*"$needle"*) ;;
	*)
		printf 'FAIL %-42s exit %s ok, but output lacked %s\n' "$name" "$rc" "$needle" >&2
		printf '     output: %s\n' "$out" >&2
		fail=$((fail + 1))
		return
		;;
	esac
	printf 'ok   %-42s exit %s\n' "$name" "$rc"
	pass=$((pass + 1))
}

zero=0000000000000000000000000000000000000000
ok=$(stub 0)

# The four answers the gate can give. Only one of them may let a push through.
check "gate clean -> allow" 0 "clean" 2222222222222222222222222222222222222222 "$(stub 0)"
check "gate MATCHED -> refuse" 1 "MATCHED" 2222222222222222222222222222222222222222 "$(stub 1)"
check "gate exit 2 -> refuse as DID NOT RUN" 1 "DID NOT RUN" 2222222222222222222222222222222222222222 "$(stub 2)"
check "gate exit 127 -> refuse, not treated as clean" 1 "DID NOT RUN" 2222222222222222222222222222222222222222 "$(stub 127)"

# The paths where there is nothing to sweep against, or nothing to sweep with.
check "no gate configured -> refuse" 1 "no privacy gate configured" 2222222222222222222222222222222222222222 ""
check "gate not executable -> refuse" 1 "not executable" 2222222222222222222222222222222222222222 "$work/does-not-exist"
check "first push (zero remote) -> refuse" 1 "FIRST push" "$zero" "$ok"

# A branch deletion carries no content, and a push to any other branch is none of the hook's
# business. Both must exit 0 WITHOUT the gate being consulted — a hook that refuses ordinary
# feature-branch pushes gets uninstalled, and then it guards nothing at all.
out=$(printf 'refs/heads/other 1111111111111111111111111111111111111111 refs/heads/other 2222222222222222222222222222222222222222\n' |
	(cd "$repo" && env -u QUINCE_PRIVACY_CHECK "$hook") 2>&1) && rc=0 || rc=$?
if [ "$rc" = 0 ] && [ -z "$out" ]; then
	printf 'ok   %-42s exit 0\n' "non-journal ref -> ignored, silent"
	pass=$((pass + 1))
else
	printf 'FAIL %-42s exit %s output [%s]\n' "non-journal ref -> ignored, silent" "$rc" "$out" >&2
	fail=$((fail + 1))
fi

out=$(printf 'refs/heads/journal %s refs/heads/journal 2222222222222222222222222222222222222222\n' "$zero" |
	(cd "$repo" && env -u QUINCE_PRIVACY_CHECK "$hook") 2>&1) && rc=0 || rc=$?
if [ "$rc" = 0 ]; then
	printf 'ok   %-42s exit 0\n' "branch deletion -> nothing to sweep"
	pass=$((pass + 1))
else
	printf 'FAIL %-42s exit %s output [%s]\n' "branch deletion -> nothing to sweep" "$rc" "$out" >&2
	fail=$((fail + 1))
fi


# Outside a git repository the sweep must still complete. This case exists because the FIX for the
# suite's environment dependence deleted the coverage that would have caught the bug it was fixing:
# once every invocation runs inside a throwaway repo, re-introducing the bare `--show-toplevel`
# passes nine of nine. Verified by mutation — reverting the hook's `2>/dev/null || true` fails this
# case and nothing else.
#
# It is not a hypothetical location. A pre-push hook runs wherever the pusher's shell is, and by
# this point the gate has ALREADY swept clean, so a crash here refuses a push for a reason that has
# nothing to do with privacy.
mkdir -p "$work/notarepo"
out=$(printf 'refs/heads/journal 1111111111111111111111111111111111111111 refs/heads/journal 2222222222222222222222222222222222222222\n' |
	(cd "$work/notarepo" && env QUINCE_PRIVACY_CHECK="$(stub 0)" "$hook") 2>&1) && rc=0 || rc=$?
case $out in
*clean*) needle_ok=1 ;;
*) needle_ok=0 ;;
esac
if [ "$rc" = 0 ] && [ "$needle_ok" = 1 ]; then
	printf 'ok   %-42s exit 0\n' "outside a git repo -> sweep still completes"
	pass=$((pass + 1))
else
	printf 'FAIL %-42s exit %s output [%s]\n' "outside a git repo -> sweep still completes" "$rc" "$out" >&2
	fail=$((fail + 1))
fi


# --help must end where the HEADER ends, not at a hard-coded line number (devlog#159). The window was
# `sed -n '2,30p'` and the header grew past it in the next edit, so the help text stopped
# mid-sentence and nothing said so. A help text that silently truncates is the same class of defect
# as a gate that silently narrows, which is this file's whole subject.
out=$("$hook" --help 2>&1) && rc=0 || rc=$?
last=$(printf '%s\n' "$out" | tail -1)
if [ "$rc" = 0 ] && printf '%s' "$last" | grep -q 'configured rather than assumed'; then
	printf 'ok   %-42s exit 0\n' "--help ends at the end of the header"
	pass=$((pass + 1))
else
	printf 'FAIL %-42s exit %s last=[%s]\n' "--help ends at the end of the header" "$rc" "$last" >&2
	fail=$((fail + 1))
fi
printf '\npre-push-journal-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
