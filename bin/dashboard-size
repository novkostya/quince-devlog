#!/bin/sh
# dashboard-size — fail when progress.md grows past the size at which it stops being a dashboard.
#
# quince-devlog#30 asked for this so that "rotation is forced rather than remembered". The file it
# guards reached 5,446 lines and 331 KB with ONE heading in it, and got there by appending — nobody
# decided it should be that size, and nothing said when it had stopped being current state.
#
#   dashboard-size                     check progress.md against the built-in ceilings
#   dashboard-size --file <f>          check another file
#   dashboard-size --max-lines N --max-bytes N
#
# Exit 0 within · 1 over · 2 DID NOT RUN.
#
# WHAT THIS CANNOT DO, up front rather than in a footnote. `quince-devlog` has NO CI — deliberately,
# and `CLAUDE.md` records that as repo-specific rather than drift — so this **cannot be a required
# check here**. It is a script that somebody or something has to run. Whether this repository should
# gain CI in order to enforce it is an Operator question; it is raised in the pull request and is
# not answered by this file.
#
# WHY IT MEASURES BYTES AS WELL AS LINES. quince-devlog#30 asked for a line limit. A line limit
# alone would pass this file today: the dashboard table is 21 lines and 20.2 KB, because a single
# rung row runs to 6 KB. A gate that a 6 KB line walks through is not gating the thing anyone cares
# about — the question is how much there is to read, and lines answer that only while lines are
# short.

set -eu

# Measured on the reduced file at the migration: 71 lines, 24,020 bytes. The ceilings are round
# numbers above that, with room for the several rungs still to come — qn.7 through qn.12 are all
# outlined, and a landed rung's row in this table has historically run to thousands of bytes.
# Roughly 2x on each axis: loose enough that ordinary growth never trips it, tight enough that a
# journal quietly reappearing does.
FILE=progress.md
MAX_LINES=150
MAX_BYTES=49152

while [ $# -gt 0 ]; do
	case $1 in
	--file)
		FILE=${2:?--file needs a path}
		shift 2
		;;
	--max-lines)
		MAX_LINES=${2:?--max-lines needs a number}
		shift 2
		;;
	--max-bytes)
		MAX_BYTES=${2:?--max-bytes needs a number}
		shift 2
		;;
	-h | --help)
		sed -n '2,26p' "$0"
		exit 0
		;;
	*)
		echo "dashboard-size: unknown argument $1" >&2
		# Exit 2, not 1: an argument typo means no measurement happened, and a typo that read as
		# a pass would make this gate exactly the kind of claim it exists to stop.
		exit 2
		;;
	esac
done

if [ ! -r "$FILE" ]; then
	echo "dashboard-size: cannot read $FILE — DID NOT RUN. This is not a pass." >&2
	exit 2
fi

lines=$(wc -l <"$FILE" | tr -d ' ')
bytes=$(wc -c <"$FILE" | tr -d ' ')

printf 'dashboard-size: %s — %s lines (max %s), %s bytes (max %s)\n' \
	"$FILE" "$lines" "$MAX_LINES" "$bytes" "$MAX_BYTES"

over=0
[ "$lines" -le "$MAX_LINES" ] || {
	echo "dashboard-size: OVER by $((lines - MAX_LINES)) lines" >&2
	over=1
}
[ "$bytes" -le "$MAX_BYTES" ] || {
	echo "dashboard-size: OVER by $((bytes - MAX_BYTES)) bytes" >&2
	over=1
}

if [ "$over" -eq 1 ]; then
	cat >&2 <<'OVER'
dashboard-size: this file is current state, not history. Something in it has stopped being
  current. Move it to the `journal` branch as a dated entry, or to `decisions/` if it is a
  decision, and leave a pointer — do not raise the ceiling to make this pass.
OVER
	exit 1
fi

echo "dashboard-size: within limits"
